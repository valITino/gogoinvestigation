# Schlüssel und Einstellungen des OSINT-Gateways.
# Die Einrichtung (./setup.sh, unter Windows .\setup.cmd) kopiert diese Datei nach .env. Ihr Assistent fragt
# die Schlüssel, den Proxy und Mythos ab und trägt sie dort ein. Von Hand geht es genauso: .env bearbeiten.
# .env wird nie eingecheckt.
# Leer lassen, was ihr nicht habt: Die Quelle bleibt dann aus, alles andere läuft.
# Stand prüfen: python3 tools/pruefen.py        Live-Test je Quelle: python3 tools/pruefen.py --live
# (unter Windows python statt python3)
#
# Mehrere Arbeitsplätze: eine ausgefüllte Kopie dieser Datei an einem geschützten Ort ablegen und bei der
# Einrichtung mitgeben:  ./setup.sh --ohne-rueckfragen --env-von /pfad/zur/datei

# --- Infrastruktur ---------------------------------------------------------------------------
# Shodan: https://account.shodan.io  (Abschnitt "API Key")
SHODAN_API_KEY=
# VirusTotal: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# Spur Context API: Token in der Spur-App unter Settings > API  (https://docs.spur.us/context-api)
SPUR_TOKEN=
# AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# --- Web --------------------------------------------------------------------------------------
# urlquery: Konto auf https://urlquery.net, Schlüssel in den Kontoeinstellungen
URLQUERY_API_KEY=
# Eigene Web-Check-Instanz. Die Einrichtung startet sie per Docker auf diesem Port.
WEBCHECK_URL=http://127.0.0.1:3000

# --- Szene ------------------------------------------------------------------------------------
# ransomware.live API PRO: kostenloser Schlüssel auf https://my.ransomware.live
RANSOMWARE_LIVE_API_KEY=
# Schlüssellose API v2 (laut Anbieter nur für private Nutzung). Nur setzen, wenn ihr sie nutzen dürft.
# RANSOMWARE_LIVE_V2=1
# RapidAPI (für telegram_kanalinfo, telegram_entitaet, telegram_suche): https://rapidapi.com
# Dort die APIs "Telegram Channel" und "Telegram Scraper API" abonnieren. Ein Schlüssel gilt für beide.
RAPIDAPI_KEY=

# --- Blockchain -------------------------------------------------------------------------------
# Bitcoin, Ethereum und TRON laufen ohne Schlüssel. Die folgenden Schlüssel erweitern die Analyse.
# TronGrid (TRON): ohne Schlüssel stark gedrosselt. Kostenlos auf https://www.trongrid.io
TRONGRID_API_KEY=
# Etherscan: weitere Ketten (Polygon, Arbitrum, Gnosis) und Gegenprüfung von Ethereum-Transaktionen.
# Kostenlos auf https://etherscan.io/apidashboard  (BNB Smart Chain, Base, Optimism: nur mit bezahltem Abo)
ETHERSCAN_API_KEY=
# Tronscan: Namen von Börsen und Diensten für TRON-Adressen. Kostenlos, Anleitung:
# https://docs.tronscan.org/getting-started/api-keys
TRONSCAN_API_KEY=
# Chainabuse: Betrugsmeldungen zu einer Adresse. Schlüssel im Profil auf https://www.chainabuse.com
# Das kostenlose Kontingent ist sehr klein, abgefragt wird nur auf ausdrücklichen Wunsch (meldungen=true).
CHAINABUSE_API_KEY=
# Iknaio GraphSense: Etiketten und Cluster. Zugang für Behörden auf Anfrage, https://www.ikna.io
IKNAIO_API_KEY=
# Eigene Instanzen statt der öffentlichen Explorer. Der Betreiber eines Explorers sieht, welche Adressen
# abgefragt werden. Wer das vermeiden will, betreibt die Dienste selbst oder leitet über OSINT_PROXY.
# Bitcoin: Adresse einer Esplora-Schnittstelle (mempool oder electrs), z. B. http://mempool.intern/api
# KRYPTO_BITCOIN_API=
# Ethereum-Familie: Adresse einer Blockscout-Instanz je Kette, z. B. KRYPTO_ETHEREUM_API, KRYPTO_POLYGON_API
# KRYPTO_ETHEREUM_API=
# TRON: Adresse einer Schnittstelle nach Art von TronGrid
# KRYPTO_TRON_API=

# --- Betrieb ----------------------------------------------------------------------------------
# Claude Mythos 5.2 vorhanden? Dann schaltet die Ermittlung (/ermittlung und die Analysten) von selbst darauf um.
# Der Abschluss (Gegenprüfung, Rapport, Protokoll) und alles andere laufen immer auf Claude Fable 5.2.
# Mythos 5.2 steht nur Organisationen offen, die Anthropic verifiziert hat. Ohne Angabe läuft alles auf Fable 5.2.
# Die Einrichtung übernimmt den Wert (ja oder nein). Nach einer Änderung also erneut ausführen.
# OSINT_MYTHOS=ja
# Alle Abfragen des Gateways über einen Proxy leiten, damit sie nicht auf eure Adresse zurückführen.
# Beispiele: socks5h://127.0.0.1:9050 (Tor), http://proxy.intern:3128
# OSINT_PROXY=
# Abstand zwischen zwei VirusTotal-Abfragen in Sekunden. 15.5 passt zum öffentlichen Schlüssel
# (4 Abfragen pro Minute). Mit Premium-Schlüssel auf 0 setzen.
# VT_INTERVALL=15.5
# Zeitzone für Protokoll und Rapport
# OSINT_ZEITZONE=Europe/Zurich
# Kennung, mit der sich das Gateway bei den Quellen meldet
# OSINT_USER_AGENT=osint-gateway/1.0
# Anderes Robin-Image (z. B. aus eurem Fork gebaut): docker build -t robin-intern <Pfad zum Fork>
# ROBIN_IMAGE=robin-intern
