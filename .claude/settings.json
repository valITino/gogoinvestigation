{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-fable-5-2",
  "availableModels": [
    "claude-fable-5-2"
  ],
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  },
  "permissions": {
    "allow": [
      "mcp__osint__fall_status",
      "mcp__osint__shodan_*",
      "mcp__osint__spur_*",
      "mcp__osint__abuseipdb_*",
      "mcp__osint__ip_einordnung",
      "mcp__osint__virustotal_*",
      "mcp__osint__urlquery_suche",
      "mcp__osint__urlquery_bericht",
      "mcp__osint__urlquery_reputation",
      "mcp__osint__urlquery_status",
      "mcp__osint__urlscan_suche",
      "mcp__osint__urlscan_ergebnis",
      "mcp__osint__urlscan_kontingent",
      "mcp__osint__wayback_verlauf",
      "mcp__osint__wayback_abruf",
      "mcp__osint__webcheck_passiv",
      "mcp__osint__ransomware_*",
      "mcp__osint__onion_sperrliste",
      "mcp__osint__telegram_*",
      "mcp__osint__chan_*",
      "mcp__osint__mastodon_*",
      "mcp__osint__krypto_*",
      "Edit(./faelle/*/arbeitsstand/**)",
      "Edit(./faelle/*/befunde.json)",
      "Edit(./faelle/*/rapport/**)",
      "Bash(python3 tools/fall.py neu *)",
      "Bash(python3 tools/fall.py aufnehmen *)",
      "Bash(python3 tools/fall.py status *)",
      "Bash(python3 tools/fall.py liste)",
      "Bash(python3 tools/rapport.py *)",
      "Bash(python3 tools/protokoll.py *)",
      "Bash(python3 tools/anhang.py *)",
      "Bash(python3 tools/audit_pruefen.py *)",
      "Bash(python3 tools/beleg.py zeigen *)",
      "Bash(python3 tools/pruefen.py)",
      "Bash(python tools/fall.py neu *)",
      "Bash(python tools/fall.py aufnehmen *)",
      "Bash(python tools/fall.py status *)",
      "Bash(python tools/fall.py liste)",
      "Bash(python tools/rapport.py *)",
      "Bash(python tools/protokoll.py *)",
      "Bash(python tools/anhang.py *)",
      "Bash(python tools/audit_pruefen.py *)",
      "Bash(python tools/beleg.py zeigen *)",
      "Bash(python tools/pruefen.py)"
    ],
    "ask": [
      "mcp__osint__urlquery_einreichen",
      "mcp__osint__urlscan_einreichen",
      "mcp__osint__wayback_sichern",
      "mcp__osint__webcheck_aktiv",
      "mcp__robin__*",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./intern/**)",
      "Read(~/OSINT-Ablage/**)",
      "Edit(~/OSINT-Ablage/**)",
      "Edit(./protokoll/**)",
      "Edit(./faelle/*/fall.json)",
      "Edit(./faelle/*/protokoll/**)",
      "Edit(./faelle/*/rohdaten/**)",
      "Edit(./faelle/*/eingang/**)",
      "Bash(python3 tools/fall.py freigabe *)",
      "Bash(python tools/fall.py freigabe *)",
      "Bash(python3 tools/fall.py quellen *)",
      "Bash(python tools/fall.py quellen *)",
      "Bash(python3 tools/fall.py entfernen *)",
      "Bash(python tools/fall.py entfernen *)",
      "Bash(python3 tools/fall.py loeschen *)",
      "Bash(python tools/fall.py loeschen *)",
      "Bash(python3 tools/beleg.py erfassen *)",
      "Bash(python tools/beleg.py erfassen *)",
      "Bash(python3 tools/pseudonymisieren.py *)",
      "Bash(python tools/pseudonymisieren.py *)",
      "Bash(python3 tools/reidentifizieren.py *)",
      "Bash(python tools/reidentifizieren.py *)",
      "Bash(python3 tools/dienste.py aus*)",
      "Bash(python tools/dienste.py aus*)",
      "Bash(python3 tools/dienste.py ein*)",
      "Bash(python tools/dienste.py ein*)",
      "Bash(*.env)",
      "Bash(*.env *)",
      "Bash(*.env.local*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(iwr *)",
      "PowerShell(irm *)",
      "PowerShell(curl *)",
      "PowerShell(wget *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/start.sh\" protokoll_hook",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/start.sh\" protokoll_hook",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/start.sh\" protokoll_hook",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/start.sh\" protokoll_hook",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/start.sh\" protokoll_hook",
            "timeout": 20
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/start.sh\" protokoll_hook",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
