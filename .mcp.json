{
  "mcpServers": {
    "osint": {
      "command": "${OSINT_PYTHON:-python3}",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/gateway/start.py"
      ],
      "timeout": 300000
    },
    "robin": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "robin-investigations:/app/investigations",
        "${ROBIN_IMAGE:-apurvsg/robin:latest}",
        "mcp"
      ],
      "timeout": 600000
    }
  }
}
