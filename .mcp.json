{
  "mcpServers": {
    "osint": {
      "command": "${OSINT_PYTHON:-python3}",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/gateway/start.py"
      ],
      "timeout": 300000
    },
    "robin": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "${ROBIN_IMAGE:-apurvsg/robin@sha256:579aae11b9100078ecd0d700f4057117e3ded6f37a37d7dfdf773bfcceded5c0}",
        "mcp"
      ],
      "timeout": 600000
    }
  }
}
